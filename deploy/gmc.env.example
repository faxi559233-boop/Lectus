# /etc/gmc/gmc.env  (mode 0640, owner root:gmc)  — never commit the real file
PORT=8787
HOST=127.0.0.1
GMC_DATA=/var/lib/gmc
GMC_STATIC=/opt/gmc
GMC_BACKUP_DIR=/var/backups/gmc
GMC_BACKUP_KEEP_DAYS=14
GMC_BACKUP_HOUR=2
GMC_TRUST_PROXY=1
GMC_LOG=1
# Strong hash for passwords people choose (2^15). Do not lower unless you measured login load.
GMC_SCRYPT_N=32768
GMC_PUSH_CONTACT=mailto:you@college.edu.pk
UV_THREADPOOL_SIZE=4
